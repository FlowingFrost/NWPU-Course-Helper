{
  "manifest_version": 3,
  "name": "选课助手·教务捕获",
  "version": "0.1.0",
  "description": "捕获教务系统「全校开课查询」页面信息，一键导入本地选课助手。不接触账号密码，仅复用当前已登录会话。",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://jwxt.nwpu.edu.cn/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://jwxt.nwpu.edu.cn/student/for-std/lesson-search*",
        "https://jwxt.nwpu.edu.cn/course-selection/*",
        "https://jwxt.nwpu.edu.cn/student/for-std/course-table*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "选课助手"
  },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
